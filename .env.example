# Copy to .env.local and fill in your real values.

# --- Supabase (https://supabase.com) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — server-side ONLY (middleware page-view logging, quote inserts). Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Resend (https://resend.com) ---
RESEND_API_KEY=
# Verified sender address (e.g. Simpli Gourmet <bookings@yourdomain.com>).
# On the free tier before adding a domain, use: onboarding@resend.dev
RESEND_FROM_EMAIL=Simpli Gourmet <onboarding@resend.dev>

# --- Site ---
# Used for auth email redirect URLs. Set to your production URL on Vercel.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
